APP_NAME="Laravel PDF Benchmark"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1

LOG_CHANNEL=stderr
DB_CONNECTION=sqlite
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

BENCHMARK_HOST_LABEL=
BENCHMARK_REGION=
BENCHMARK_HOST_PROVIDER=
BENCHMARK_HOST_INSTANCE_TYPE=
BENCHMARK_HOST_CPU_ALLOCATION=
BENCHMARK_HOST_PURPOSE=
BENCHMARK_HOST_VCPU=
BENCHMARK_HOST_MEMORY_MIB=
BENCHMARK_CLOUDFLARE_PLAN=
BENCHMARK_BLADEPDF_PLAN=
BENCHMARK_BLADEPDF_CONCURRENCY=
BENCHMARK_COOLDOWN_SECONDS=10

LARAVEL_PDF_DRIVER=browsershot
LARAVEL_PDF_NODE_BINARY=/usr/local/bin/node
LARAVEL_PDF_NPM_BINARY=/usr/local/bin/npm
LARAVEL_PDF_NODE_MODULES_PATH=/workspace/node_modules
LARAVEL_PDF_TEMP_PATH=/workspace/storage/framework/benchmark
LARAVEL_PDF_NO_SANDBOX=true
LARAVEL_PDF_DOMPDF_CHROOT=/workspace
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_METRICS_URL=http://gotenberg:9464/metrics
PERSISTENT_CHROMIUM_URL=http://chromium-persistent:9222

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BLADEPDF_API_KEY=
BLADEPDF_RETRY_TIMES=1
BLADEPDF_TIMEOUT=60
