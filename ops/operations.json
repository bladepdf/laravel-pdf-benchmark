      "requires_node": false,
      "requires_chrome": false,
      "asset_strategy": "Laravel package discovers, rewrites, and uploads local assets automatically",
      "ownership": {"queue": "provider", "concurrency": "provider plan", "storage": "provider/application", "retry": "application/provider", "monitoring": "provider/application", "browser_updates": "provider"},
      "operational_responsibility": "Low",
      "source": "https://github.com/bladepdf/laravel"
    },
    "browsershot-persistent": {
      "install_commands": ["Same dependencies as Browsershot", "Operate a persistent Puppeteer browser endpoint"],
      "external_binaries": ["node", "chrome/chromium"],
      "requires_docker": true,
      "requires_node": true,
      "requires_chrome": true,
      "asset_strategy": "Same as Browsershot",
      "ownership": {"queue": "application", "concurrency": "application", "storage": "application", "retry": "application", "monitoring": "operator", "browser_updates": "operator"},
